<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tg_white"
    android:gravity="center_vertical"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="10dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <TextView
            android:id="@+id/rowAvatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="T"
            android:textColor="@color/tg_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <su.thegrapht.app.CircleImageView
            android:id="@+id/rowAvatarImage"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:visibility="gone" />

        <View
            android:id="@+id/rowPresence"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|right"
            android:background="@drawable/bg_presence_dot"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1F1F1F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6E7C8B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:gravity="right"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8E9CA8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/rowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_unread_badge"
            android:gravity="center"
            android:minWidth="20dp"
            android:minHeight="20dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="0"
            android:textColor="@color/tg_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
